[Unit]
Description=osips-ui: web-интерфейс управления OpenSIPS
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=osips-ui
Group=osips-ui
WorkingDirectory=/opt/osips-ui/back-osips-ui
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/osips-ui/back-osips-ui/.venv/bin/gunicorn -c gunicorn_conf.py app.main:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

# БД приложения и логи
StateDirectory=osips-ui
ReadWritePaths=/opt/osips-ui/back-osips-ui/data

# базовое ужесточение
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
