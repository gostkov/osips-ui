# --- обязательно поменять в проде ---
# openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# первый пользователь создаётся только если таблица users пуста
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

# БД приложения (пользователи, реестр серверов, аудит)
APP_DB_PATH=/opt/osips-ui/data/osips-ui.db

# собранный фронтенд; backend отдаёт его сам, nginx не нужен
STATIC_DIR=/opt/osips-ui/front-osips-ui/dist
SERVE_STATIC=true

# в проде фронтенд отдаётся тем же процессом, поэтому CORS не нужен
CORS_ORIGINS=[]

DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=720
RBAC_CACHE_TTL=5
MI_TIMEOUT=5
MI_DUMP_TIMEOUT=15
ROUTING_PAGE_SIZE=20
ROUTING_TTL_DAYS=7
SIPREGS_PAGE_SIZE=25

# параметры gunicorn
GUNICORN_LISTEN=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_LOGLEVEL=info
