# Переменные для install/docker-compose.prod.yml. Скопировать в install/.env и заполнить.
# Пути (APP_DB_PATH, STATIC_DIR) зашиты в образ, здесь их задавать не нужно.

# --- обязательно ---
# openssl rand -hex 32
# Этим ключом подписываются JWT и шифруются пароли к БД opensips: смена ключа
# обесценит уже сохранённые пароли серверов, их придётся ввести заново.
SECRET_KEY=

# первый администратор создаётся только пока таблица users пуста
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- публикация порта на хосте ---
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=8000

# --- прочее (значения по умолчанию можно не трогать) ---
# Swagger и /openapi.json без авторизации; на публичном контуре выключайте
DOCS_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=720
RBAC_CACHE_TTL=5
MI_TIMEOUT=5
MI_DUMP_TIMEOUT=15
SIPREGS_PAGE_SIZE=25
DIALPLAN_PAGE_SIZE=25
BLACKLIST_PAGE_SIZE=25

GUNICORN_WORKERS=2
GUNICORN_LOGLEVEL=info
